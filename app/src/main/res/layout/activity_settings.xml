<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="88dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
            app:title="@string/settings" />
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/settings_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="32dp"
                android:paddingTop="4dp">
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/settings_section_install_mode"
                            android:textAppearance="@style/TextAppearance.VInstall.TitleSmall"
                            android:textColor="?attr/colorPrimary"
                            android:paddingStart="4dp" />
                        <RadioGroup
                            android:id="@+id/radio_group_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_btn_normal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/mode_normal"
                                android:textAppearance="@style/TextAppearance.VInstall.BodyLarge" />
                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_btn_root"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/mode_root"
                                android:textAppearance="@style/TextAppearance.VInstall.BodyLarge" />
                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_btn_shizuku"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/mode_shizuku"
                                android:textAppearance="@style/TextAppearance.VInstall.BodyLarge" />
                        </RadioGroup>
                        <TextView
                            android:id="@+id/text_root_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/text_shizuku_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_request_shizuku"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:text="@string/shizuku_request_permission"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/settings_section_behavior"
                            android:textAppearance="@style/TextAppearance.VInstall.TitleSmall"
                            android:textColor="?attr/colorPrimary"
                            android:paddingStart="4dp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_confirm_install"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/settings_confirm_install"
                            android:textAppearance="@style/TextAppearance.VInstall.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="64dp"
                            android:text="@string/settings_confirm_install_desc"
                            android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_auto_clear_cache"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/settings_auto_clear_cache"
                            android:textAppearance="@style/TextAppearance.VInstall.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="64dp"
                            android:text="@string/settings_auto_clear_cache_desc"
                            android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_debug_window"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/settings_debug_window"
                            android:textAppearance="@style/TextAppearance.VInstall.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="64dp"
                            android:text="@string/settings_debug_window_desc"
                            android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/settings_section_appearance"
                            android:textAppearance="@style/TextAppearance.VInstall.TitleSmall"
                            android:textColor="?attr/colorPrimary"
                            android:paddingStart="4dp" />
                        <LinearLayout
                            android:id="@+id/layout_language"
                            style="@style/Widget.VInstall.Row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_language"
                                android:textAppearance="@style/TextAppearance.VInstall.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/text_current_language"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/layout_theme"
                            style="@style/Widget.VInstall.Row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_theme"
                                android:textAppearance="@style/TextAppearance.VInstall.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/text_current_theme"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/layout_dialog_style"
                            style="@style/Widget.VInstall.Row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_dialog_style"
                                android:textAppearance="@style/TextAppearance.VInstall.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/text_current_dialog_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/history_title"
                            android:textAppearance="@style/TextAppearance.VInstall.TitleSmall"
                            android:textColor="?attr/colorPrimary"
                            android:paddingStart="4dp" />
                        <TextView
                            android:id="@+id/text_history_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.VInstall.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_history"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:text="@string/history_view" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_clear_history"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:text="@string/history_clear_all"
                                android:textColor="?attr/colorError"
                                app:strokeColor="?attr/colorError" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/settings_section_crash_reports"
                            android:textAppearance="@style/TextAppearance.VInstall.TitleSmall"
                            android:textColor="?attr/colorPrimary"
                            android:paddingStart="4dp" />
                        <TextView
                            android:id="@+id/text_crash_log_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.VInstall.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_crash_log"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:text="@string/crash_log_view" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_clear_crash_log"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:text="@string/crash_log_clear"
                                android:textColor="?attr/colorError"
                                app:strokeColor="?attr/colorError" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/settings_section_about"
                            android:textAppearance="@style/TextAppearance.VInstall.TitleSmall"
                            android:textColor="?attr/colorPrimary"
                            android:paddingStart="4dp" />
                        <LinearLayout
                            android:id="@+id/layout_credits"
                            style="@style/Widget.VInstall.Row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_credits"
                                    android:textAppearance="@style/TextAppearance.VInstall.BodyLarge"
                                    android:textColor="?attr/colorOnSurface" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_credits_desc"
                                    android:textAppearance="@style/TextAppearance.VInstall.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <com.vinstall.alwiz.ui.FloatingNav
        android:id="@+id/floating_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp" />
</FrameLayout>
